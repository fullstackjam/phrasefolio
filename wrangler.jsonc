{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phrasefolio",
  "account_id": "3adb6783a9b30e9f7f2c36c3a3ba7bf9",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "phrasefolio.fullstackjam.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phrasefolio",
      "database_id": "57449379-e549-4d5f-ae36-07f0707c0a27"
    }
  ],
  "secrets": { "required": ["PHRASEFOLIO_API_TOKEN"] },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
